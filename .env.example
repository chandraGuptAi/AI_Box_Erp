# ---- Service ----
PORT=8200
DEBUG=false
LOG_LEVEL=INFO
# Same value as AI_BOX_ERP_SERVICE_TOKEN in AI_python_backend/.env. Empty = no check (local dev only).
SERVICE_TOKEN=

# ---- Report file (the only data source: this service calls no ERP API) ----
# Larger files get 413. The gateway allows up to 51 MB on /api/ai-box-erp.
MAX_UPLOAD_MB=50
MAX_FILE_ROWS=20000

# ---- LLM (OpenAI-compatible chat completions; DeepSeek by default). REQUIRED: empty = 503 ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=4096
AI_SAMPLE_ROWS=25

# Reports built at the same time; a request waits SLOT_WAIT_SECONDS for a free slot, then gets 429.
MAX_CONCURRENT_JOBS=2
SLOT_WAIT_SECONDS=30

# ---- Saved reports (Postgres): empty disables saving ----
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/ai_box
DB_SCHEMA=ai_box_erp
